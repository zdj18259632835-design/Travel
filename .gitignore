# 虚拟环境与依赖
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# 密钥：绝不提交。api_keys/ 目录内另有一层 .gitignore 做双保险
.env
.env.*
!.env.example
# 注意：必须写 api_keys/* 而不是 api_keys/ ——
# git 无法在「被排除的目录」内部再用 ! 放行文件，
# 写成整目录排除会把本目录的 README.md 与内层 .gitignore 一起挡掉，
# 开源仓库里就丢了说明和第二层保护。
api_keys/*
!api_keys/.gitignore
!api_keys/README.md
*.key
*.pem
*_token
.cache/
data/*.db
data/*.db-journal

# 生成的行程产物（演示时可临时保留，不入库）
output/

# 编辑器/系统
# .vscode 里是运行与调试配置，属于项目的一部分，要提交
.idea/
.DS_Store
Thumbs.db
