{
  "city": "成都",
  "guide": {
    "culture": "成都的节奏是慢出来的：人民公园的竹椅茶、玉林路的小酒馆，构成把休闲当日常的城市性格。三国文化与市井烟火叠在同一街区，川菜重麻多于重辣，夜生活21点后才开始。热门景区普遍要预约，上午看展、下午喝茶、夜里吃火锅，才像本地人一样使用这座城市。",
    "signature_foods": [
      "火锅（建议点鸳鸯锅，微辣对外地人偏辣；玉林、建设路一带老店密度最高）",
      "串串香与冒菜（奎星楼街、香香巷，按签计价，先问清一根签的价格）",
      "麻婆豆腐与回锅肉（陈麻婆豆腐老字号，配米饭，不要单点当菜吃）",
      "甜水面、凉粉、钟水饺（文殊院洞子口一带，上午去品种全）",
      "兔头与冷吃兔（双流老妈兔头/建设巷，麻辣味比五香味更本地）",
      "蛋烘糕、糖油果子（校园周边与老社区门口，2-6元一份）",
      "川菜馆子点菜建议一人一道：夫妻肺片、蒜泥白肉、开水白菜按需",
      "茶馆盖碗茶（人民公园鹤鸣茶社，配采耳是标准本地玩法）"
    ],
    "photo_spots": [
      "宽窄巷子砖墙与门头（上午8点前人少）",
      "锦江合江亭与安顺廊桥夜景（日落蓝调时刻）",
      "东郊记忆红砖厂房与火车头（下午侧光）",
      "武侯祠红墙竹影夹道（开门第一批进）",
      "杜甫草堂茅屋与雪后红梅（冬季12-2月）",
      "太古里大慈寺金顶与红墙对比（夜晚亮灯）",
      "成都博物馆屋顶观景平台看天府广场（免费）",
      "九眼桥至兰桂坊河岸（21点后霓虹全开）"
    ],
    "tips": [
      "博物馆类（成都博物馆、金沙、四川博物院）多数周一闭馆，行程别把周一排成室内主项",
      "热门景区走官方公众号实名预约，节假日门票常提前2-3天放完",
      "打车在太古里/春熙路极难停靠，优先地铁；市区通勤早晚高峰按40分钟预留",
      "川菜馆子辣度按本地标准，点菜时明确说微辣或要鸳鸯锅",
      "茶馆采耳、酒吧卡座、景区讲解都先问价再消费，写进小票",
      "支付基本全手机，老人随行的话备少量零钱和纸质门票截图",
      "雨天下钻馆与茶馆，晴天再排青城山/都江堰，山路湿滑不建议赶"
    ],
    "safety": [
      "九眼桥、兰桂坊散场集中在凌晨1-2点，提前订返程或走地铁末班前时段",
      "酒吧卡座低消与拼桌纠纷常见，入座前确认价格与人数上限",
      "深夜不坐无牌黑车，用平台叫车并分享行程给同行者",
      "建设巷、宽窄巷子人流大，背包前置、手机挂绳，儿童走内侧",
      "青城山/都江堰夜宿山区的，注意山路无照明与冬季路面结冰"
    ],
    "nightlife_areas": [
      "九眼桥—兰桂坊（府河两岸，酒吧最密，吵与闹是主调，地铁2号线牛王庙步行可达）",
      "玉林—芳沁街（小酒馆与苍蝇馆子混合区，本地人下班后主场，步行为主）",
