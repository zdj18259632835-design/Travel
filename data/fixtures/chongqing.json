{
  "city": "重庆",
  "guide": {
    "culture": "重庆建在坡上，导航里的200米可能是三十层台阶或一段高架。两江把城市切成互不相连的片区，轻轨穿楼、索道过江是通勤工具而不是景点。口味重麻重油，火锅是社交场合；夏天极热、冬天多雾，行程要把户外放在早晚，把商圈与博物馆放在正午。",
    "signature_foods": [
      "老火锅（牛油九宫格，毛肚鸭肠按秒涮；点微辣或鸳鸯锅，外地人常低估重庆辣度）",
      "豌杂面与小面（早餐标配，干溜少汤更地道，配一碗冰粉解辣）",
      "烤兔与烧烤（南山与九街夜宵带，营业到凌晨3点）",
      "泉水鸡与江湖菜（南山黄桷垭一条街，偏辣偏油，两人一份足够）",
      "毛血旺与辣子鸡（解放碑周边老馆子，人均60-90元）",
      "山城小汤圆与抄手（八一路、民生路小吃巷，甜咸分开点）",
      "折耳根相关小菜（本地蘸水常见，不接受要在点单时说）",
      "泡茶与盖碗茶（鹅岭公园、南山茶馆，人均20-40元坐半天）"
    ],
    "photo_spots": [
      "千厮门大桥上拍洪崖洞全景（日落后20分钟蓝调）",
      "戴家巷悬崖步道与嘉陵江同框",
      "李子坝轻轨穿楼观景平台（上午侧光）",
      "长江索道轿厢内俯瞰江面",
      "南山一棵树看渝中半岛夜景（天黑后半小时）",
      "解放碑碑体与周边霓虹对比",
      "鹅岭二厂天台与老厂房",
      "磁器口正街与后街河堤（早上8点前人少）",
      "白象居老居民楼连廊（本地机位，注意不要扰民）"
    ],
    "tips": [
      "直线距离不等于步行距离，看海拔与台阶；同一片区过江常要绕行30分钟",
      "夏季7-8月常超38摄氏度，午后户外项目要压缩，冬季多雾能见度低",
      "洪崖洞、长江索道等热门点走官方公众号买/约，现场排队常超40分钟",
      "轻轨2号线沿江段本身就是观光，比打车更能躲开拥堵",
      "雨天石板路与江岸步道很滑，穿防滑鞋",
      "问路用楼层概念（1楼可能等于山脚20楼），导航到附近后问本地人更快",
      "火锅晚上市21点后价格与等位都下降，能接受就错峰"
    ],
    "safety": [
      "解放碑—较场口夜店带凌晨散场人流大，财物前置、结伴回酒店",
      "未满18岁不进入酒吧、夜店与KTV，入场会查验身份证",
      "江边与观景平台夜间护栏有限，不要翻越或久坐边缘",
      "深夜山路与隧道段出租车不愿短途，尽量用平台预约单",
      "洪崖洞、磁器口等景区节假日单向限流，跟着引导走不逆行"
    ],
    "nightlife_areas": [
      "九街（江北，夜宵加酒吧一体，22点最热闹，本地年轻客群主场）",
      "解放碑—较场口（夜店与清吧密集，地铁1/2号线交汇，散场最方便）",
      "戴家巷—洪崖洞（江景小酒馆，看得到对岸灯光，游客与本地人混排）",
      "南滨路（对岸看半岛夜景，餐饮与电影院一条线，风大）",
      "北仓—观音桥（文创园区小酒馆与咖啡吧，白天到夜晚连续营业）",
      "南山（泉水鸡夜宵加山顶夜景，需车程上山，回程23点前更稳）"
    ]
  },
