{
  "city": "长沙",
  "guide": {
    "culture": "长沙是一座把夜当白天用的城市：凌晨一点黄兴路还在排队，湘江边散步的人和夜宵摊同时存在。吃的是重油重辣的湘菜与茶颜悦色，玩的是橘子洲、岳麓山和一堆综艺衍生打卡点。节奏比成都快、比西安热闹，白天景区人不算多，真正的拥堵从20点开始。",
    "signature_foods": [
      "湘菜小炒（辣椒炒肉、外婆菜，费大厨/壹盏灯一类，人均80-120元）",
      "臭豆腐（黑色经典一类现炸，先小份试辣，别一次买五份）",
      "糖油粑粑与葱油粑粑（南门口、太平街支巷，2-5元一个）",
      "口味虾与小龙虾（湘江边与渔人码头，夏季按两计价，先问清一斤几只）",
      "米粉（长沙米粉偏细，早餐店里加肉饼蛋是本地吃法）",
      "烧烤与夜宵（四方坪、冬瓜山一带，营业到凌晨3点）",
      "茶颜悦色（幽兰拿铁、声声乌龙，商圈内间隔几百米就有一家，不必排长队）",
      "湘式甜品与紫苏桃子姜（太平街小摊，酸甜解辣）"
    ],
    "photo_spots": [
      "橘子洲青年毛泽东雕塑正面（上午顺光）",
      "岳麓山爱晚亭红叶（11月下旬到12月初）",
      "杜甫江阁与湘江夜景（日落蓝调）",
      "超级文和友内部复刻老街（任意时段，需排队）",
      "太平街马王平路牌坊与红灯笼",
      "IFS国金中心顶层雕塑花园",
      "谢子龙影像艺术馆清水混凝土楼梯",
      "梅溪湖大剧院花瓣外立面（夜间亮灯）"
    ],
    "tips": [
      "湖南省博物馆周一闭馆且要提前预约，马王堆汉墓陈列务必留2小时",
      "热门餐饮20点前取号最划算，晚市高峰排队常超90分钟",
      "茶颜悦色门店极密，看到排长队可换相邻分店",
      "地铁1/2号线覆盖五一广场、橘子洲、省博方向，夜间打车在解放西最难停靠",
      "湘菜辣度按本地标准，点单时明确说微辣并要清淡配菜",
      "夏季午后雷雨频繁，户外景区排在上午，下午给博物馆与商场",
      "橘子洲景区小火车单程另收费，全程步行往返约4公里"
    ],
    "safety": [
      "解放西路23点后人流极大，财物前置、结伴行动，不接受陌生人灌酒与拼桌",
      "夜店与酒吧需查验身份证，未满18岁不接待",
      "湘江边夜游不要下水或翻越护栏，风大且照明不均",
      "凌晨返程优先地铁末班前的时段，从解放西步行到地铁站比原地等车快",
      "夜市小龙虾等生冷食物注意份量，随团有儿童时选熟食"
    ],
    "nightlife_areas": [
      "解放西路—杜甫江阁（夜店与清吧同街混排，23点最挤，地铁1号线黄兴广场站步行）",
      "渔人码头—湘江北路（江边夜宵与烧烤，夏天主场，冬季风大体感冷）",
      "黄兴路步行街—太平街（茶饮、小吃与网红店到24点，家庭友好）",
      "五一大道—芙蓉广场（连锁KTV与餐吧集中，商务取向）",
      "梅溪湖—河西（大剧院与Livehouse活动型夜场，散场后人流动快）",
      "四方坪—开福北（本地夜宵与啤酒，价格比解放西低四成）"
    ]
  },
