{
  "city": "杭州",
  "guide": {
    "culture": "杭州把山水放进城市日常：西湖是本地人散步的路而不是景区，运河边留着老仓库与书店，城西则是互联网公司的节奏。菜系清淡偏甜，重食材本味。周末与节假日西湖周边限行、地铁拥挤，行程要把户外排在清晨、把博物馆与商圈排在午后，雨天反而最适合喝茶看展。",
    "signature_foods": [
      "西湖醋鱼（楼外楼一类老店做法偏酸甜，接受度分化，建议两人一条小的）",
      "龙井虾仁（明前茶季最鲜，配米饭而非单吃）",
      "东坡肉与干菜焖肉（一人二两足够，偏甜偏油）",
      "片儿川与奎元馆面条（笋片雪菜是灵魂，早餐或午市最稳）",
      "知味观小笼与猫耳朵（点心外带比堂食快，杭式口味偏甜）",
      "定胜糕、条头糕等杭式糕点（河坊街现做，别买真空包装）",
      "藕粉与桂花羹（冲调类甜品，适合老人小孩）",
      "酱鸭与卤味（社区菜场周边小店更实惠）"
    ],
    "photo_spots": [
      "断桥与白堤晨雾（冬季12-2月，7点前）",
      "曲院风荷荷塘木桥（6-7月荷花）",
      "雷峰塔与夕照山（日落逆光）",
      "杨公堤与茅家埠野趣水道（清晨）",
      "太子湾公园郁金香（3月下旬至4月上旬）",
      "拱宸桥与桥西直街运河老仓库（傍晚）",
      "钱江新城城市阳台灯光秀（周二五六晚）",
      "良渚博物院清水混凝土水面（下午侧光）",
      "九溪十八涧茶园林荫（夏季戏水）"
    ],
    "tips": [
      "浙江省博物馆、良渚博物院等免费但需实名预约，周一普遍闭馆",
      "西湖景区周末与节假日实行机动车单双号限行，别自驾进景区",
      "断桥、苏堤上午9点后人潮密集，想拍空镜要7点前到",
      "地铁1号线串龙翔桥—武林广场—城站，去西湖比打车快",
      "灵隐寺需先买景区门票再买香花券，两段收费容易漏",
      "龙井村买茶问清等级与克价，别在路边被带去茶农家",
      "春季多雨、夏季高温，户外建议排在上午，午后转博物馆与商圈"
    ],
    "safety": [
      "夜间西湖边照明有限，孤山与茅家埠一带不单独走",
      "太子湾、九溪等水域禁止下水，儿童需全程牵手",
      "钱江新城灯光秀散场人流极大，注意防踩踏，走外围出口",
      "夜场酒吧与KTV查验身份证，未满18岁不接待",
      "梅雨季（6月中至7月上旬）山道湿滑，灵隐与九溪减少徒步"
    ],
    "nightlife_areas": [
      "南山路—柳浪闻莺（湖边清吧与音乐餐吧，环境安静，价格偏高）",
      "湖滨—龙翔桥（商圈夜逛加小酒馆，地铁上盖，散场最方便）",
      "武林路—中山北路（本地人吃饭喝酒的街区，价格比湖滨低三成）",
      "钱江新城城市阳台（灯光秀带动的夜间散步带，餐饮到23点）",
      "青芝坞—玉古路（学院派小酒馆与夜宵，学生客群）",
      "拱宸桥—桥西直街（运河边茶馆与手作市集，22点后偏静）"
    ]
  },
