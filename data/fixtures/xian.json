{
  "city": "西安",
  "guide": {
    "culture": "西安把十三朝的东西摊在马路上走：城墙里是老城棋盘，城墙外是地铁与商圈。节奏比成都快，说话声更大，饮食以面食与牛羊为主，一人一碗泡馍是常态而不是将就。博物馆密度极高，多数免费但要实名预约，周一普遍闭馆，安排行程时这一条比天气更容易毁掉半天。",
    "signature_foods": [
      "牛羊肉泡馍（建议手掰馍，掰到黄豆大小；本地人去西羊市、北广济街，不在北院门主街吃）",
      "肉夹馍（腊汁肉配白馍，老潼关走脆皮；早上配胡辣汤是本地吃法）",
      "Biangbiang面与裤带面（油泼辣子，一人二两足够，面分量普遍偏大）",
      "凉皮与麻酱酿皮（魏家一类快餐连锁稳定，街边摊注意卫生）",
      "葫芦鸡与陕菜（西安饭庄一类老字号，人均90-130元）",
      "柿子饼、镜糕、甑糕（早市买，甜度高，别一次买多）",
      "冰峰汽水与酸梅汤（吃泡馍标配，冰峰要玻璃瓶的）",
      "灌汤小笼与蒸饺（回民街大皮院一带，下午2点后出餐快）"
    ],
    "photo_spots": [
      "城墙永宁门瓮城与吊桥（日落亮灯后）",
      "大唐不夜城中轴线灯笼街（19:30后全亮）",
      "钟楼与开元商城观景平台同框（夜晚）",
      "书院门笔墨纸砚摊位（上午顺光）",
      "陕西历史博物馆唐风建筑外廊",
      "曲江池南岸水面倒影（清晨）",
      "回民街牌坊与化觉巷巷口（傍晚炊烟）",
      "兵马俑一号坑大棚纵深（开馆第一批）"
    ],
    "tips": [
      "博物馆几乎全按官方公众号实名放票，兵马俑旺季提前7天，陕历博提前3-5天",
      "陕历博、碑林、博物院类多数周一闭馆，把周一排成城墙+街区+夜市",
      "市内地铁2号线串钟楼—永宁门—小寨—北客站，比打车稳",
      "城墙骑行一圈13.7公里约2小时，避开正午与周末下午",
      "景点讲解分官方与私招，认准挂牌讲解员，野导会带去购物点",
      "面食分量普遍大，两人点一份面加一份凉菜更省",
      "干燥，冬春风沙大，博物馆久待建议自带水与润喉"
    ],
    "safety": [
      "夜市与酒吧街（德福巷、南门）深夜出租车议价，尽量用平台叫车",
      "兵马俑、华清宫沿线有拉客一日游与假讲解，只走官方售票与官方渠道",
      "回民街主街人流大，手机放前袋，儿童走内侧",
      "城墙马道无护栏段夜间照明弱，别在边缘久坐",
      "《长恨歌》散场22点后临潼方向打车紧张，提前订回程或住临潼"
    ],
    "nightlife_areas": [
      "南门—德福巷（老酒吧街，清吧与闹吧混排，从城墙永宁门步行10分钟）",
      "大唐不夜城—曲江（夜游型，灯光与街头表演，21点后人最多）",
      "钟楼—骡马市（老城内夜宵与酒吧，地铁2号线直达，散场后步行回酒店方便）",
      "小寨—兴善寺西街（学生与年轻客群，餐饮到24点）",
      "灞河/浐灞沿岸（夜跑与露营风酒吧，风大，冬季体感很冷）",
      "临潼华清宫片区（看《长恨歌》才有夜间客流，非演出时段偏空）"
    ]
  },
