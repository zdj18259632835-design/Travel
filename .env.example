# ============================================================================
# 复制本文件为 .env 后填写（.env 已被 .gitignore 排除，不会提交）
# 只有前两项是"可选增强"，全部留空也能完整跑通演示（自动降级到本地数据源）
# ============================================================================

# --- 通义千问（阿里百炼 DashScope，OpenAI 兼容通道）---
# 申请：https://bailian.console.aliyun.com/ → API-KEY 管理（需阿里云实名认证）
# 作用：自然语言意图理解、UGC 口碑归纳、行程文案润色、联网搜索网友评价
DASHSCOPE_API_KEY=
TRIPAGENT_LLM_MODEL=qwen-plus

# --- 高德开放平台 Web 服务（景点/酒吧/KTV/游乐园 POI + 路径规划）---
# 申请：https://console.amap.com/ → 创建应用 → Key 服务平台必须选「Web 服务」→ 个人实名认证
# 作用：把本地 fixture 数据升级为全国任意城市的实时结构化 POI（含评分/人均/营业时间）
AMAP_KEY=
# 若你的高德账号开启了「数字签名」校验，填安全密钥；未开启则留空
AMAP_SECRET=

# --- 和风天气（可选，有 key 时优先于 Open-Meteo 拿 15 天预报 + 官方预警）---
# 申请：https://console.qweather.com/ ；注意每个账号有独立 API Host
QWEATHER_KEY=
QWEATHER_HOST=

# --- 行为开关 ---
# 1 = 完全离线（只读本地 fixture，评委现场断网也能演示）
TRIPAGENT_OFFLINE=0
# 外部 API 结果缓存目录与有效期（小时），省配额 + 提速
TRIPAGENT_CACHE_TTL_HOURS=6
